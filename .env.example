# Browser-public Supabase configuration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key

# Server-only. Never prefix this variable with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_server_only_key
RATE_LIMIT_HASH_SECRET=replace_with_a_random_server_only_value
OPENAI_API_KEY=replace_with_your_server_only_key
OPENAI_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime
# Alternative Azure OpenAI configuration:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Voice requires a separate Realtime-capable deployment. Use a dedicated supported transcription deployment.
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=gpt-4o-mini-transcribe
# Library dispatch: set only this variable in Vercel for Library.
TRIGGER_SECRET_KEY=
# Trigger.dev Library worker: configure these names in the Trigger.dev dashboard (some are declared above for local server use):
# SUPABASE_URL, SUPABASE_SECRET_KEY, AZURE_OPENAI_ENDPOINT,
# AZURE_OPENAI_API_KEY, AZURE_OPENAI_DEPLOYMENT, AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT, SUPADATA_API_KEY.
SUPADATA_API_KEY=
SPOTFLOW_SECRET_KEY=
SPOTFLOW_WEBHOOK_SECRET=
SPOTFLOW_PLUS_PLAN_ID=
SPOTFLOW_MODE=test
BACHS_MODE=sandbox
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_PLUS_PRODUCT_ID=
APP_BASE_URL=http://localhost:5173
PORT=8787
