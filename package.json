{
  "name": "stranerd-anatomy-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "assets:heart": "node scripts/import-hubmap-heart.mjs",
    "assets:heart:download": "node scripts/import-hubmap-heart.mjs --download",
    "validate:assets": "node scripts/import-hubmap-heart.mjs --validate-only",
    "assets:manifest": "node scripts/generate-anatomy-manifest.mjs",
    "materials:dry-run": "node scripts/import-materials.mjs --dry-run",
    "materials:import": "node scripts/import-materials.mjs --apply",
    "materials:verify": "node scripts/verify-materials-import.mjs"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.1.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "@supabase/supabase-js": "^2.112.1",
    "@trigger.dev/sdk": "^4.5.11",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsdom": "^26.1.0",
    "lucide-react": "1.28.0",
    "openai": "7.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "sharp": "^0.35.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
